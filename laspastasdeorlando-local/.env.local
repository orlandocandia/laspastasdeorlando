# =============================================================================
# MODO LOCAL (OFFLINE) — Las Pastas de Orlando
# =============================================================================
# Este archivo configura el sistema para trabajar con una base de datos SQLite
# local (archivo dev.db en la raiz del paquete). No requiere conexion a internet.
#
# Para activar este modo:
#   Linux/Mac:   ./scripts/switch-mode.sh local
#   Windows:     scripts\switch-mode.bat local
# Luego reiniciar el sistema con start-linux.sh o start-windows.bat
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (SQLite local)
# -----------------------------------------------------------------------------
# URL de la base local. El archivo dev.db esta en la raiz del paquete.
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# NextAuth (autenticacion)
# -----------------------------------------------------------------------------
# Generar una clave secreta unica con:  openssl rand -base64 32
# Si no tiene openssl, use cualquier cadena larga y aleatoria (min 32 caracteres).
NEXTAUTH_SECRET=cambiar-por-una-clave-secreta-unica-y-aleatoria-de-al-menos-32-caracteres
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email / SMTP (OPCIONAL en modo local)
# -----------------------------------------------------------------------------
# Si no configura SMTP, los correos se simulan en los logs del servidor.
# Para Gmail: use un "App Password" de Google (no su contrasena habitual).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Las Pastas de Orlando <no-reply@localhost>"

# -----------------------------------------------------------------------------
# Admin (destinatario de notificaciones internas)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@pastasorlando.com
ADMIN_WHATSAPP=543754419324

# -----------------------------------------------------------------------------
# WhatsApp Bot (OPCIONAL — notificaciones automaticas)
# -----------------------------------------------------------------------------
# Obtener API key en: https://textmebot.com
# Si esta vacio, las notificaciones WhatsApp se omiten silenciosamente.
TEXTMEBOT_APIKEY=

# -----------------------------------------------------------------------------
# Vercel Blob Storage (NO USAR en modo local)
# -----------------------------------------------------------------------------
# En modo local, las imagenes se guardan en public/images/uploads/.
# Dejar vacio en modo local.
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Puerto del servidor (opcional, por defecto 3000)
# -----------------------------------------------------------------------------
PORT=3000
