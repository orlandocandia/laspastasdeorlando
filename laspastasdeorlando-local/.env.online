# =============================================================================
# MODO ONLINE (TURSO) — Las Pastas de Orlando
# =============================================================================
# Este archivo configura el sistema para conectarse a una base de datos Turso
# (libSQL) en la nube. Requiere conexion a internet.
#
# INSTRUCCIONES:
# 1. Crear una cuenta gratuita en https://turso.tech
# 2. Crear una base de datos:   turso db create pastas-orlando
# 3. Obtener la URL:             turso db show pastas-orlando --url
# 4. Crear un token de acceso:   turso db tokens create pastas-orlando
# 5. Reemplazar los valores abajo con sus credenciales reales.
# 6. Activar modo online:
#      Linux/Mac:   ./scripts/switch-mode.sh online
#      Windows:     scripts\switch-mode.bat online
# 7. Reiniciar el sistema.
# 8. (Opcional) Sincronizar datos locales a Turso:
#      Linux:   ./scripts/sync-to-turso.sh
#      Windows: scripts\sync-to-turso.bat
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Turso / libSQL en la nube)
# -----------------------------------------------------------------------------
# Reemplazar con la URL real de su base Turso.
DATABASE_URL=libsql://pastas-orlando-SU-USUARIO.turso.io

# Token de acceso de Turso (obtener con: turso db tokens create pastas-orlando)
DATABASE_AUTH_TOKEN=colocar-aqui-su-token-de-turso
# TURSO_AUTH_TOKEN=colocar-aqui-su-token-de-turso

# -----------------------------------------------------------------------------
# NextAuth (autenticacion)
# -----------------------------------------------------------------------------
# Usar la MISMA clave secreta que en modo local para que las sesiones coincidan.
NEXTAUTH_SECRET=cambiar-por-una-clave-secreta-unica-y-aleatoria-de-al-menos-32-caracteres
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Las Pastas de Orlando <no-reply@pastasorlando.com>"

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@pastasorlando.com
ADMIN_WHATSAPP=543754419324

# -----------------------------------------------------------------------------
# WhatsApp Bot (opcional)
# -----------------------------------------------------------------------------
TEXTMEBOT_APIKEY=

# -----------------------------------------------------------------------------
# Vercel Blob Storage (solo si se despliega tambien en Vercel)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Puerto del servidor
# -----------------------------------------------------------------------------
PORT=3000
