# =============================================================================
# VARIABLES DE ENTORNO — Pastas Orlando
# =============================================================================
# Copiar a .env.local para desarrollo, y configurar en Vercel para producción.
# Las variables SIN prefijo NEXT_PUBLIC_ solo están disponibles en el servidor.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Prisma)
# -----------------------------------------------------------------------------
# Local (SQLite)
DATABASE_URL=file:./db/custom.db

# Producción (Turso / libSQL) — solo en Vercel
# DATABASE_URL=libsql://tu-db.turso.io?authToken=tu-token
# DATABASE_AUTH_TOKEN=tu-auth-token

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=tu-clave-secreta-aqui
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# URL pública de la app (para generar links de recuperación)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En Vercel: NEXT_PUBLIC_APP_URL=https://pastasorlando.vercel.app

# -----------------------------------------------------------------------------
# Email — SMTP (Gmail u otro)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail-sin-espacios
SMTP_SECURE=false
SMTP_FROM="Pastas Orlando <tu-email@gmail.com>"

# -----------------------------------------------------------------------------
# Admin (destinatario de notificaciones)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=tu-email@gmail.com
ADMIN_WHATSAPP=543754419324

# -----------------------------------------------------------------------------
# Vercel Blob Storage (subida de imágenes)
# -----------------------------------------------------------------------------
# ⚠️ OBLIGATORIO en producción (Vercel). Sin este token, las subidas de imagen fallan.
# Crear un Blob Store en: https://vercel.com/dashboard/stores
# Luego copiar el token "Read and Write" aquí.
# En desarrollo local no es necesario (las imágenes se guardan en public/images/uploads/).
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# WhatsApp via TextMeBot (notificación automática al admin)
# -----------------------------------------------------------------------------
# Obtener API key en: https://textmebot.com
# ⚠️ La API key demo dura 3 días. Para uso permanente, suscribirse al plan de $1/mes.
# Si TEXTMEBOT_APIKEY no está configurada, las notificaciones WhatsApp se saltan silenciosamente.
TEXTMEBOT_APIKEY=
