# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# Excepción: el template del paquete local SI se commitea (scripts, README, .env templates)
!local-package-template/
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Database (generated from schema)
/db/

# Upload directory (user-uploaded files)
/upload/

# Worklog
worklog.md

# Examples
/examples/

# =============================================================================
# Paquete local standalone (laspastasdeorlando-local/)
# =============================================================================
# El paquete completo (build + node_modules + dev.db) se distribuye via GitHub
# Releases (tag v1.0.0-local), NO se commitea al repo.
# Para reconstruirlo desde el codigo fuente, ejecutar: ./build-local-package.sh
laspastasdeorlando-local/

# Tarballs de distribucion (generados por build-local-package.sh, distribuidos via Releases)
laspastasdeorlando-local.tar.gz
laspastasdeorlando-local.zip
# =============================================================================
# Migración de imágenes
# =============================================================================
# Backups de DB creados por scripts/migrar-imagenes-a-local.mjs
prisma/dev.db.backup-*

# Directorios de test del script de migración
.test-migracion/
.test-download/

# Imágenes descargadas por la migración (se guardan en public/images/productos/)
# Estas son imágenes de productos generadas a partir de URLs externas migradas.
# No se commitean para no inflar el repo — cada usuario las regenera con el script.
public/images/productos/

# Imágenes de uploads descargadas desde Vercel Blob Storage
# (cuando se usa BLOB_READ_WRITE_TOKEN, los blobs se descargan acá)
# No se commitean — cada usuario las descarga con el script si tiene el token.
public/images/uploads/productos-terminados/*
!public/images/uploads/productos-terminados/.gitkeep
public/images/uploads/productos/*
!public/images/uploads/productos/.gitkeep
public/images/uploads/categorias/*
!public/images/uploads/categorias/.gitkeep
public/images/uploads/materias-primas/*
!public/images/uploads/materias-primas/.gitkeep
public/images/uploads/insumos/*
!public/images/uploads/insumos/.gitkeep
public/images/uploads/usuarios/*
!public/images/uploads/usuarios/.gitkeep
public/images/uploads/personas/*
!public/images/uploads/personas/.gitkeep

# =============================================================================
# Backups locales (generados por scripts/backup-turso.mjs con --no-upload o --local)
# =============================================================================
*.sql.gz
*.sql
!prisma/schema.sql
!prisma/seeds/*.sql
backups/

# =============================================================================
# Workflows locales (no se commitean porque el PAT del bot no tiene scope 'workflow')
# El YAML del workflow está incluido en scripts/README-backup-turso.md
# para que el usuario lo cree manualmente via GitHub UI.
# =============================================================================
.github/workflows/
